* File kpotguard_varassign.inc
* Capacity-potential guard for myopic runs solved by barrier without crossover.
* After each solve Balmorel fixes the capacities of the year just solved (IY411FIRST).
* A barrier solution can exceed a binding potential (SUBTECHGROUPKPOT, TECHGROUPKPOT) by a
* numerical residual. Fixed, that residual makes QKSUBTECHGROUP*/QKTECHGROUP* infeasible in
* the next year (reported by presolve as e.g. QWNDDISPATCH/QSOLEDISPATCH of the new vintage).
* Here a potential is raised to the fixed capacity only if the excess is at most
* max(IKPOTGUARD_ATOL, IKPOTGUARD_RTOL*potential). Larger excesses are not touched and are
* reported in IKPOTGUARD_BIG. All adjustments are reported in IKPOTGUARD_SUB and IKPOTGUARD_TG.

LOOP(IY411FIRST,

* ---------------- SUBTECHGROUPKPOT ----------------
IKPOTGUARD_LHS(CCCRRRAAA,TECH_GROUP,SUBTECH_GROUP) = 0;
IKPOTGUARD_EXC(CCCRRRAAA,TECH_GROUP,SUBTECH_GROUP) = 0;

* Country level (as QKSUBTECHGROUPC)
IKPOTGUARD_LHS(C,TECH_GROUP,SUBTECH_GROUP)$SUBTECHGROUPKPOT(C,TECH_GROUP,SUBTECH_GROUP) =
    SUM((IA,G)$(IAGKFX(IY411FIRST,IA,G) AND GDATA(G,'GDTECHGROUP') EQ TECH_GROUP_VALUE(TECH_GROUP) AND GDATA(G,'GDSUBTECHGROUP') EQ SUBTECH_GROUP_VALUE(SUBTECH_GROUP) AND ICA(C,IA)),
        GKFX(IY411FIRST,IA,G) - VDECOM_EXO_ACCUM.L(IY411FIRST,IA,G)$IGDECOMEXOPOT(IY411FIRST,IA,G))
  + SUM(IAGK_HASORPOT(IY411FIRST,IA,G)$(SUM(Y$(YVALUE(Y) LE YVALUE(IY411FIRST)),IAGKNY(Y,IA,G)) AND GDATA(G,'GDTECHGROUP') EQ TECH_GROUP_VALUE(TECH_GROUP) AND GDATA(G,'GDSUBTECHGROUP') EQ SUBTECH_GROUP_VALUE(SUBTECH_GROUP) AND ICA(C,IA)),
        VGKNACCUMNET.L(IY411FIRST,IA,G));

* Region level (as QKSUBTECHGROUPR)
IKPOTGUARD_LHS(IR,TECH_GROUP,SUBTECH_GROUP)$SUBTECHGROUPKPOT(IR,TECH_GROUP,SUBTECH_GROUP) =
    SUM((IA,G)$(IAGKFX(IY411FIRST,IA,G) AND GDATA(G,'GDTECHGROUP') EQ TECH_GROUP_VALUE(TECH_GROUP) AND GDATA(G,'GDSUBTECHGROUP') EQ SUBTECH_GROUP_VALUE(SUBTECH_GROUP) AND RRRAAA(IR,IA)),
        GKFX(IY411FIRST,IA,G) - VDECOM_EXO_ACCUM.L(IY411FIRST,IA,G)$IGDECOMEXOPOT(IY411FIRST,IA,G))
  + SUM(IAGK_HASORPOT(IY411FIRST,IA,G)$(SUM(Y$(YVALUE(Y) LE YVALUE(IY411FIRST)),IAGKNY(Y,IA,G)) AND GDATA(G,'GDTECHGROUP') EQ TECH_GROUP_VALUE(TECH_GROUP) AND GDATA(G,'GDSUBTECHGROUP') EQ SUBTECH_GROUP_VALUE(SUBTECH_GROUP) AND RRRAAA(IR,IA)),
        VGKNACCUMNET.L(IY411FIRST,IA,G));

* Area level (as QKSUBTECHGROUPA)
IKPOTGUARD_LHS(IA,TECH_GROUP,SUBTECH_GROUP)$SUBTECHGROUPKPOT(IA,TECH_GROUP,SUBTECH_GROUP) =
    SUM(G$(IAGKFX(IY411FIRST,IA,G) AND GDATA(G,'GDTECHGROUP') EQ TECH_GROUP_VALUE(TECH_GROUP) AND GDATA(G,'GDSUBTECHGROUP') EQ SUBTECH_GROUP_VALUE(SUBTECH_GROUP)),
        GKFX(IY411FIRST,IA,G) - VDECOM_EXO_ACCUM.L(IY411FIRST,IA,G)$IGDECOMEXOPOT(IY411FIRST,IA,G))
  + SUM(G$(IAGK_HASORPOT(IY411FIRST,IA,G) AND SUM(Y$(YVALUE(Y) LE YVALUE(IY411FIRST)),IAGKNY(Y,IA,G)) AND GDATA(G,'GDTECHGROUP') EQ TECH_GROUP_VALUE(TECH_GROUP) AND GDATA(G,'GDSUBTECHGROUP') EQ SUBTECH_GROUP_VALUE(SUBTECH_GROUP)),
        VGKNACCUMNET.L(IY411FIRST,IA,G));

IKPOTGUARD_EXC(CCCRRRAAA,TECH_GROUP,SUBTECH_GROUP)$(SUBTECHGROUPKPOT(CCCRRRAAA,TECH_GROUP,SUBTECH_GROUP)
      AND IKPOTGUARD_LHS(CCCRRRAAA,TECH_GROUP,SUBTECH_GROUP) GT SUBTECHGROUPKPOT(CCCRRRAAA,TECH_GROUP,SUBTECH_GROUP))
    = IKPOTGUARD_LHS(CCCRRRAAA,TECH_GROUP,SUBTECH_GROUP) - SUBTECHGROUPKPOT(CCCRRRAAA,TECH_GROUP,SUBTECH_GROUP);
IKPOTGUARD_BIG(IY411FIRST,CCCRRRAAA,TECH_GROUP,SUBTECH_GROUP)$(IKPOTGUARD_EXC(CCCRRRAAA,TECH_GROUP,SUBTECH_GROUP)
      GT MAX(IKPOTGUARD_ATOL, IKPOTGUARD_RTOL*SUBTECHGROUPKPOT(CCCRRRAAA,TECH_GROUP,SUBTECH_GROUP)))
    = IKPOTGUARD_EXC(CCCRRRAAA,TECH_GROUP,SUBTECH_GROUP);
IKPOTGUARD_SUB(IY411FIRST,CCCRRRAAA,TECH_GROUP,SUBTECH_GROUP)$(IKPOTGUARD_EXC(CCCRRRAAA,TECH_GROUP,SUBTECH_GROUP)
      AND NOT IKPOTGUARD_BIG(IY411FIRST,CCCRRRAAA,TECH_GROUP,SUBTECH_GROUP))
    = IKPOTGUARD_EXC(CCCRRRAAA,TECH_GROUP,SUBTECH_GROUP);
SUBTECHGROUPKPOT(CCCRRRAAA,TECH_GROUP,SUBTECH_GROUP)$IKPOTGUARD_SUB(IY411FIRST,CCCRRRAAA,TECH_GROUP,SUBTECH_GROUP)
    = SUBTECHGROUPKPOT(CCCRRRAAA,TECH_GROUP,SUBTECH_GROUP) + IKPOTGUARD_SUB(IY411FIRST,CCCRRRAAA,TECH_GROUP,SUBTECH_GROUP);

* ---------------- TECHGROUPKPOT ----------------
IKPOTGUARD_LHST(CCCRRRAAA,TECH_GROUP) = 0;
IKPOTGUARD_EXCT(CCCRRRAAA,TECH_GROUP) = 0;

IKPOTGUARD_LHST(C,TECH_GROUP)$TECHGROUPKPOT(C,TECH_GROUP) =
    SUM((IA,G)$(IAGKFX(IY411FIRST,IA,G) AND GDATA(G,'GDTECHGROUP') EQ TECH_GROUP_VALUE(TECH_GROUP) AND ICA(C,IA)),
        GKFX(IY411FIRST,IA,G) - VDECOM_EXO_ACCUM.L(IY411FIRST,IA,G)$IGDECOMEXOPOT(IY411FIRST,IA,G))
  + SUM(IAGK_HASORPOT(IY411FIRST,IA,G)$(SUM(Y$(YVALUE(Y) LE YVALUE(IY411FIRST)),IAGKNY(Y,IA,G)) AND GDATA(G,'GDTECHGROUP') EQ TECH_GROUP_VALUE(TECH_GROUP) AND ICA(C,IA)),
        VGKNACCUMNET.L(IY411FIRST,IA,G));
IKPOTGUARD_LHST(IR,TECH_GROUP)$TECHGROUPKPOT(IR,TECH_GROUP) =
    SUM((IA,G)$(IAGKFX(IY411FIRST,IA,G) AND GDATA(G,'GDTECHGROUP') EQ TECH_GROUP_VALUE(TECH_GROUP) AND RRRAAA(IR,IA)),
        GKFX(IY411FIRST,IA,G) - VDECOM_EXO_ACCUM.L(IY411FIRST,IA,G)$IGDECOMEXOPOT(IY411FIRST,IA,G))
  + SUM(IAGK_HASORPOT(IY411FIRST,IA,G)$(SUM(Y$(YVALUE(Y) LE YVALUE(IY411FIRST)),IAGKNY(Y,IA,G)) AND GDATA(G,'GDTECHGROUP') EQ TECH_GROUP_VALUE(TECH_GROUP) AND RRRAAA(IR,IA)),
        VGKNACCUMNET.L(IY411FIRST,IA,G));
IKPOTGUARD_LHST(IA,TECH_GROUP)$TECHGROUPKPOT(IA,TECH_GROUP) =
    SUM(G$(IAGKFX(IY411FIRST,IA,G) AND GDATA(G,'GDTECHGROUP') EQ TECH_GROUP_VALUE(TECH_GROUP)),
        GKFX(IY411FIRST,IA,G) - VDECOM_EXO_ACCUM.L(IY411FIRST,IA,G)$IGDECOMEXOPOT(IY411FIRST,IA,G))
  + SUM(G$(IAGK_HASORPOT(IY411FIRST,IA,G) AND SUM(Y$(YVALUE(Y) LE YVALUE(IY411FIRST)),IAGKNY(Y,IA,G)) AND GDATA(G,'GDTECHGROUP') EQ TECH_GROUP_VALUE(TECH_GROUP)),
        VGKNACCUMNET.L(IY411FIRST,IA,G));

IKPOTGUARD_EXCT(CCCRRRAAA,TECH_GROUP)$(TECHGROUPKPOT(CCCRRRAAA,TECH_GROUP)
      AND IKPOTGUARD_LHST(CCCRRRAAA,TECH_GROUP) GT TECHGROUPKPOT(CCCRRRAAA,TECH_GROUP))
    = IKPOTGUARD_LHST(CCCRRRAAA,TECH_GROUP) - TECHGROUPKPOT(CCCRRRAAA,TECH_GROUP);
IKPOTGUARD_TG(IY411FIRST,CCCRRRAAA,TECH_GROUP)$(IKPOTGUARD_EXCT(CCCRRRAAA,TECH_GROUP)
      AND IKPOTGUARD_EXCT(CCCRRRAAA,TECH_GROUP) LE MAX(IKPOTGUARD_ATOL, IKPOTGUARD_RTOL*TECHGROUPKPOT(CCCRRRAAA,TECH_GROUP)))
    = IKPOTGUARD_EXCT(CCCRRRAAA,TECH_GROUP);
TECHGROUPKPOT(CCCRRRAAA,TECH_GROUP)$IKPOTGUARD_TG(IY411FIRST,CCCRRRAAA,TECH_GROUP)
    = TECHGROUPKPOT(CCCRRRAAA,TECH_GROUP) + IKPOTGUARD_TG(IY411FIRST,CCCRRRAAA,TECH_GROUP);

* ---------------- Exogenous decommissioning (QDECOM_EXO_LIM) ----------------
* Accumulated exogenous decommissioning fixed for the next year must not exceed existing capacity.
IKPOTGUARD_DEC(IY411FIRST,IA,G)$(IGDECOMEXOPOT(IY411FIRST,IA,G)
      AND VDECOM_EXO_ACCUM.L(IY411FIRST,IA,G) GT GKFX(IY411FIRST,IA,G)
      AND VDECOM_EXO_ACCUM.L(IY411FIRST,IA,G) - GKFX(IY411FIRST,IA,G) LE MAX(IKPOTGUARD_ATOL, IKPOTGUARD_RTOL*GKFX(IY411FIRST,IA,G)))
    = VDECOM_EXO_ACCUM.L(IY411FIRST,IA,G) - GKFX(IY411FIRST,IA,G);
VDECOM_EXO_ACCUM.FX(IY411FIRST,IA,G)$IKPOTGUARD_DEC(IY411FIRST,IA,G) = GKFX(IY411FIRST,IA,G);
);

display "KPOT guard: potential adjustments (MW) and excesses NOT adjusted (IKPOTGUARD_BIG)", IKPOTGUARD_SUB, IKPOTGUARD_TG, IKPOTGUARD_DEC, IKPOTGUARD_BIG;
