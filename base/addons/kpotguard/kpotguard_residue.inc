* File kpotguard_residue.inc
* Residue guard for myopic runs solved by barrier without crossover (second part of the kpotguard addon).
* Included from Balmorelbb4.sim after each solve, before the investments of the year just solved are fixed.
*
* A barrier solution without crossover is an interior point: investment and decommissioning
* variables that are zero at a vertex come back as small positive levels (typically 1E-6 to 1 MW).
* Fixed for the next year, thousands of such residues enter its LP as tiny existing capacities with
* their own dispatch, storage and balance rows, and barrier can then fail with numerical difficulties.
*
* Here, for the year just solved:
* 1. Investment and endogenous decommissioning levels below IKPOTGUARD_ATOL are set to zero. The
*    accumulated variable that contains each level is corrected by the same amount, so the
*    accumulation equations still hold exactly.
* 2. Net capacity below IKPOTGUARD_ATOL that is left after endogenous decommissioning is
*    decommissioned completely.
* 3. Accumulated levels below IKPOTGUARD_ROUNDOFF in absolute value (equation tolerance of the
*    barrier, round-off from step 1) are set to zero.
* Exogenous decommissioning is not changed (it follows input data; see kpotguard_varassign.inc).
* Counts and sums of all changes are displayed in IKPOTGUARD_RES.

LOOP(IY411FIRST,

* ---------------- Generation investments (VGKN enters VGKNACCUMNET with +1) ----------------
IKPOTGUARD_RG(IA,G) = 0;
IKPOTGUARD_RG(IA,G)$(VGKN.L(IY411FIRST,IA,G) AND ABS(VGKN.L(IY411FIRST,IA,G)) LT IKPOTGUARD_ATOL) = VGKN.L(IY411FIRST,IA,G);
VGKN.L(IY411FIRST,IA,G)$IKPOTGUARD_RG(IA,G) = 0;
VGKNACCUMNET.L(IY411FIRST,IA,G)$IKPOTGUARD_RG(IA,G) = VGKNACCUMNET.L(IY411FIRST,IA,G) - IKPOTGUARD_RG(IA,G);
IKPOTGUARD_RES(IY411FIRST,'VGKN_N')   = SUM((IA,G)$IKPOTGUARD_RG(IA,G), 1);
IKPOTGUARD_RES(IY411FIRST,'VGKN_SUM') = SUM((IA,G), IKPOTGUARD_RG(IA,G));

* ---------------- Endogenous decommissioning (VDECOM_ENDO enters VGKNACCUMNET with -1) ----------------
$ifi not %DECOM%==yes $goto kpotguard_res_nodecom
$ifi not %LIFETIME_DECOM_ENDO_G%==yes $ifi not %ECONOMIC_DECOM_ENDO_G%==yes $goto kpotguard_res_nodecom
IKPOTGUARD_RG(IA,G) = 0;
IKPOTGUARD_RG(IA,G)$(VDECOM_ENDO.L(IY411FIRST,IA,G) AND ABS(VDECOM_ENDO.L(IY411FIRST,IA,G)) LT IKPOTGUARD_ATOL) = VDECOM_ENDO.L(IY411FIRST,IA,G);
VDECOM_ENDO.L(IY411FIRST,IA,G)$IKPOTGUARD_RG(IA,G) = 0;
VDECOM_ENDO_ACCUM.L(IY411FIRST,IA,G)$IKPOTGUARD_RG(IA,G) = VDECOM_ENDO_ACCUM.L(IY411FIRST,IA,G) - IKPOTGUARD_RG(IA,G);
VGKNACCUMNET.L(IY411FIRST,IA,G)$IKPOTGUARD_RG(IA,G) = VGKNACCUMNET.L(IY411FIRST,IA,G) + IKPOTGUARD_RG(IA,G);
IKPOTGUARD_RES(IY411FIRST,'DECOM_N')   = SUM((IA,G)$IKPOTGUARD_RG(IA,G), 1);
IKPOTGUARD_RES(IY411FIRST,'DECOM_SUM') = SUM((IA,G), IKPOTGUARD_RG(IA,G));

* Decommissioning brought back (VDECOM_ENDO_BACK enters VGKNACCUMNET with +1, VDECOM_ENDO_ACCUM with -1)
$ifi not %REVERT_DECOM_ENDO_G%==yes $goto kpotguard_res_noback
IKPOTGUARD_RG(IA,G) = 0;
IKPOTGUARD_RG(IA,G)$(VDECOM_ENDO_BACK.L(IY411FIRST,IA,G) AND ABS(VDECOM_ENDO_BACK.L(IY411FIRST,IA,G)) LT IKPOTGUARD_ATOL) = VDECOM_ENDO_BACK.L(IY411FIRST,IA,G);
VDECOM_ENDO_BACK.L(IY411FIRST,IA,G)$IKPOTGUARD_RG(IA,G) = 0;
VDECOM_ENDO_ACCUM.L(IY411FIRST,IA,G)$IKPOTGUARD_RG(IA,G) = VDECOM_ENDO_ACCUM.L(IY411FIRST,IA,G) + IKPOTGUARD_RG(IA,G);
VGKNACCUMNET.L(IY411FIRST,IA,G)$IKPOTGUARD_RG(IA,G) = VGKNACCUMNET.L(IY411FIRST,IA,G) - IKPOTGUARD_RG(IA,G);
IKPOTGUARD_RES(IY411FIRST,'BACK_N')   = SUM((IA,G)$IKPOTGUARD_RG(IA,G), 1);
IKPOTGUARD_RES(IY411FIRST,'BACK_SUM') = SUM((IA,G), IKPOTGUARD_RG(IA,G));
$label kpotguard_res_noback

* Net capacity below IKPOTGUARD_ATOL left after decommissioning: decommission it completely
IKPOTGUARD_RG(IA,G) = 0;
IKPOTGUARD_RG(IA,G)$(IGDECOM(G) AND SUM(Y$(YVALUE(Y) LE YVALUE(IY411FIRST)), IAGKNY(Y,IA,G))
      AND VDECOM_ENDO_ACCUM.L(IY411FIRST,IA,G) GT 0
      AND VGKNACCUMNET.L(IY411FIRST,IA,G) GT 0 AND VGKNACCUMNET.L(IY411FIRST,IA,G) LT IKPOTGUARD_ATOL)
    = VGKNACCUMNET.L(IY411FIRST,IA,G);
VDECOM_ENDO.L(IY411FIRST,IA,G)$IKPOTGUARD_RG(IA,G)       = VDECOM_ENDO.L(IY411FIRST,IA,G) + IKPOTGUARD_RG(IA,G);
VDECOM_ENDO_ACCUM.L(IY411FIRST,IA,G)$IKPOTGUARD_RG(IA,G) = VDECOM_ENDO_ACCUM.L(IY411FIRST,IA,G) + IKPOTGUARD_RG(IA,G);
VGKNACCUMNET.L(IY411FIRST,IA,G)$IKPOTGUARD_RG(IA,G)      = 0;
IKPOTGUARD_RES(IY411FIRST,'NETREST_N')   = SUM((IA,G)$IKPOTGUARD_RG(IA,G), 1);
IKPOTGUARD_RES(IY411FIRST,'NETREST_SUM') = SUM((IA,G), IKPOTGUARD_RG(IA,G));

VDECOM_ENDO.L(IY411FIRST,IA,G)$(ABS(VDECOM_ENDO.L(IY411FIRST,IA,G)) LT IKPOTGUARD_ROUNDOFF)             = 0;
VDECOM_ENDO_ACCUM.L(IY411FIRST,IA,G)$(ABS(VDECOM_ENDO_ACCUM.L(IY411FIRST,IA,G)) LT IKPOTGUARD_ROUNDOFF) = 0;
$ifi %REVERT_DECOM_ENDO_G%==yes VDECOM_ENDO_BACK.L(IY411FIRST,IA,G)$(ABS(VDECOM_ENDO_BACK.L(IY411FIRST,IA,G)) LT IKPOTGUARD_ROUNDOFF) = 0;
$label kpotguard_res_nodecom

VGKNACCUMNET.L(IY411FIRST,IA,G)$(ABS(VGKNACCUMNET.L(IY411FIRST,IA,G)) LT IKPOTGUARD_ROUNDOFF) = 0;

* ---------------- Electricity transmission (VXKN enters VXKNACCUMNET with +1) ----------------
IKPOTGUARD_RX(IRE,IRI) = 0;
IKPOTGUARD_RX(IRE,IRI)$(VXKN.L(IY411FIRST,IRE,IRI) AND ABS(VXKN.L(IY411FIRST,IRE,IRI)) LT IKPOTGUARD_ATOL) = VXKN.L(IY411FIRST,IRE,IRI);
VXKN.L(IY411FIRST,IRE,IRI)$IKPOTGUARD_RX(IRE,IRI) = 0;
VXKNACCUMNET.L(IY411FIRST,IRE,IRI)$IKPOTGUARD_RX(IRE,IRI) = VXKNACCUMNET.L(IY411FIRST,IRE,IRI) - IKPOTGUARD_RX(IRE,IRI);
VXKNACCUMNET.L(IY411FIRST,IRE,IRI)$(ABS(VXKNACCUMNET.L(IY411FIRST,IRE,IRI)) LT IKPOTGUARD_ROUNDOFF) = 0;
IKPOTGUARD_RES(IY411FIRST,'VXKN_N')   = SUM((IRE,IRI)$IKPOTGUARD_RX(IRE,IRI), 1);
IKPOTGUARD_RES(IY411FIRST,'VXKN_SUM') = SUM((IRE,IRI), IKPOTGUARD_RX(IRE,IRI));

* ---------------- Hydrogen transmission (VXH2KN enters VXH2KNACCUMNET with +1) ----------------
$ifi not %HYDROGEN%==yes $goto kpotguard_res_noh2
IKPOTGUARD_RX(IRE,IRI) = 0;
IKPOTGUARD_RX(IRE,IRI)$(VXH2KN.L(IY411FIRST,IRE,IRI) AND ABS(VXH2KN.L(IY411FIRST,IRE,IRI)) LT IKPOTGUARD_ATOL) = VXH2KN.L(IY411FIRST,IRE,IRI);
VXH2KN.L(IY411FIRST,IRE,IRI)$IKPOTGUARD_RX(IRE,IRI) = 0;
VXH2KNACCUMNET.L(IY411FIRST,IRE,IRI)$IKPOTGUARD_RX(IRE,IRI) = VXH2KNACCUMNET.L(IY411FIRST,IRE,IRI) - IKPOTGUARD_RX(IRE,IRI);
VXH2KNACCUMNET.L(IY411FIRST,IRE,IRI)$(ABS(VXH2KNACCUMNET.L(IY411FIRST,IRE,IRI)) LT IKPOTGUARD_ROUNDOFF) = 0;
IKPOTGUARD_RES(IY411FIRST,'VXH2KN_N')   = SUM((IRE,IRI)$IKPOTGUARD_RX(IRE,IRI), 1);
IKPOTGUARD_RES(IY411FIRST,'VXH2KN_SUM') = SUM((IRE,IRI), IKPOTGUARD_RX(IRE,IRI));
$label kpotguard_res_noh2

* ---------------- OptiFlow capacity and transport (VPROCKAPNEW enters VPROCKAPACCUMNET with +1;
* VPROCEXIMKAPACCUMNET is recomputed in the next year from the fixed VPROCEXIMKAPNEW) ----------------
$ifi not %OPTIFLOW%==yes $goto kpotguard_res_noopti
IKPOTGUARD_RP(IA,PROC) = 0;
IKPOTGUARD_RP(IA,PROC)$(VPROCKAPNEW.L(IY411FIRST,IA,PROC) AND ABS(VPROCKAPNEW.L(IY411FIRST,IA,PROC)) LT IKPOTGUARD_ATOL) = VPROCKAPNEW.L(IY411FIRST,IA,PROC);
VPROCKAPNEW.L(IY411FIRST,IA,PROC)$IKPOTGUARD_RP(IA,PROC) = 0;
VPROCKAPACCUMNET.L(IY411FIRST,IA,PROC)$IKPOTGUARD_RP(IA,PROC) = VPROCKAPACCUMNET.L(IY411FIRST,IA,PROC) - IKPOTGUARD_RP(IA,PROC);
VPROCKAPACCUMNET.L(IY411FIRST,IA,PROC)$(ABS(VPROCKAPACCUMNET.L(IY411FIRST,IA,PROC)) LT IKPOTGUARD_ROUNDOFF) = 0;
IKPOTGUARD_RES(IY411FIRST,'VPROCKAPNEW_N')   = SUM((IA,PROC)$IKPOTGUARD_RP(IA,PROC), 1);
IKPOTGUARD_RES(IY411FIRST,'VPROCKAPNEW_SUM') = SUM((IA,PROC), IKPOTGUARD_RP(IA,PROC));

IKPOTGUARD_RT(IAE,IAI,PROC) = 0;
IKPOTGUARD_RT(IAE,IAI,PROC)$(VPROCEXIMKAPNEW.L(IY411FIRST,IAE,IAI,PROC) AND ABS(VPROCEXIMKAPNEW.L(IY411FIRST,IAE,IAI,PROC)) LT IKPOTGUARD_ATOL) = VPROCEXIMKAPNEW.L(IY411FIRST,IAE,IAI,PROC);
VPROCEXIMKAPNEW.L(IY411FIRST,IAE,IAI,PROC)$IKPOTGUARD_RT(IAE,IAI,PROC) = 0;
IKPOTGUARD_RES(IY411FIRST,'VPROCEXIMKAPNEW_N')   = SUM((IAE,IAI,PROC)$IKPOTGUARD_RT(IAE,IAI,PROC), 1);
IKPOTGUARD_RES(IY411FIRST,'VPROCEXIMKAPNEW_SUM') = SUM((IAE,IAI,PROC), IKPOTGUARD_RT(IAE,IAI,PROC));
$label kpotguard_res_noopti
);

display "KPOT guard: residues below IKPOTGUARD_ATOL set to 0 before fixing (counts _N, sums _SUM in MW or process units)", IKPOTGUARD_RES;
