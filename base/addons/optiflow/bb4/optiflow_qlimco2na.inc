* CCU in optiflow, requires CCS add-on.

$ifi not %CCS%==yes $goto NOCCUS

*Subtract CO2 captured in OptiFlow from carbon balance"
* Outer SUM(C)/ICA removed in these terms: each area belongs to exactly one country, so results are unchanged.
* Adapted to low-reg's own emission terms from navigating_maritime_transition_pathways 2422525.
+SUM((IA,IPROCFROM,IPROCTO,FLOW)$(ICO2_CC(IPROCFROM,FLOW) AND FLOWFROMTOPROC(IY411,IA,IPROCFROM,IPROCTO,FLOW)), SUM((IS3,T), IHOURSINST(IS3,T) * IHOURFRAC * VFLOW(IY411,IA,IPROCFROM,IPROCTO,FLOW,IS3,T)))

*Re-ad CO2 used for CU in OptiFlow"
$ifi %baloptCCU%==yes -SUM((IA,IPROCFROM,IPROCTO,FLOW)$(ICO2_CU(IPROCFROM,FLOW) AND FLOWFROMTOPROC(IY411,IA,IPROCFROM,IPROCTO,FLOW)), SUM((IS3,T), IHOURSINST(IS3,T) * IHOURFRAC * VFLOW(IY411,IA,IPROCFROM,IPROCTO,FLOW,IS3,T)))

$label NOCCUS

- SUM((IA,PROCSOURCE,FLOW)$(PROC_T(PROCSOURCE) AND SOSIBU2INDIC(IY411,PROCSOURCE,FLOW,'GHGEMISSION_nonbio')),  SUM((IS3,T), IHOURSINST(IS3,T) * VFLOWSOURCE(IY411,IA,PROCSOURCE,FLOW,IS3,T)$(SUM(IPROCTO,FLOWFROMTOPROC(IY411,IA,PROCSOURCE,IPROCTO,FLOW))))* SOSIBU2INDIC(IY411,PROCSOURCE,FLOW,'GHGEMISSION_nonbio'))


$ifi not %optiLCA%==yes $goto NOLCA

*** LCA emissions (impact factor = climate change)

* Emissions from process capacity (IPROCFLOW_PROC), climate change only
- SUM(C,
    SUM((IA,PROC,FLOW)$(
          ICA(C,IA)
      AND IPROCFLOW_LCA_VALUES(IY411,IA,PROC,FLOW,'CLIMATE_CHANGE','IPROCFLOW_PROC')
      AND (PROCDATA(PROC,'PROCLIFETIME') > 0)
    ),
      VPROCKAPACCUMNET(IY411,IA,PROC)
    * IPROCFLOW_LCA_VALUES(IY411,IA,PROC,FLOW,'CLIMATE_CHANGE','IPROCFLOW_PROC')
    / PROCDATA(PROC,'PROCLIFETIME')
    )
  )

* Emissions from process outflow (IPROCFLOW_FLOWOUT), climate change only
- SUM(C,
    SUM((IA,IPROCFROM,FLOW)$(
          ICA(C,IA)
      AND IPROCFLOW_LCA_VALUES(IY411,IA,IPROCFROM,FLOW,'CLIMATE_CHANGE','IPROCFLOW_OUTFLOW')
    ),
      SUM((IPROCTO,IS3,T)$FLOWFROMTOPROC(IY411,IA,IPROCFROM,IPROCTO,FLOW),
          IHOURSINST(IS3,T) * IHOURFRAC * VFLOW(IY411,IA,IPROCFROM,IPROCTO,FLOW,IS3,T)
      )
    * IPROCFLOW_LCA_VALUES(IY411,IA,IPROCFROM,FLOW,'CLIMATE_CHANGE','IPROCFLOW_OUTFLOW')
    )
  )


$label NOLCA