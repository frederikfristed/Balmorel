* CCU in optiflow, requires CCS add-on.

$ifi not %CCS%==yes $goto NOCCUS

*Subtract CO2 captured in OptiFlow from carbon balance"
+SUM((IA,IPROCFROM,IPROCTO,FLOW)$(ICO2_CC(IPROCFROM,FLOW) AND FLOWFROMTOPROC(IY411,IA,IPROCFROM,IPROCTO,FLOW)), SUM((IS3,T), IHOURSINST(IS3,T) * IHOURFRAC * VFLOW(IY411,IA,IPROCFROM,IPROCTO,FLOW,IS3,T)))

*Re-ad CO2 used for CU in OptiFlow"
$ifi %baloptCCU%==yes -SUM((IA,IPROCFROM,IPROCTO,FLOW)$(ICO2_CU(IPROCFROM,FLOW) AND FLOWFROMTOPROC(IY411,IA,IPROCFROM,IPROCTO,FLOW)), SUM((IS3,T), IHOURSINST(IS3,T) * IHOURFRAC * VFLOW(IY411,IA,IPROCFROM,IPROCTO,FLOW,IS3,T)))

$label NOCCUS

*Direct and process emissions from fuel use
- SUM((IA, FLOW, IS3, T)$(PROC_T('CO2_Sink')),
    IHOURSINST(IS3, T) * VFLOWSINK(IY411, IA, 'CO2_Sink', FLOW, IS3, T)
)

*CO2 emissions from transport
- VFLOWINDICVALUES(IY411,'GHGEMISSION_nonbio')